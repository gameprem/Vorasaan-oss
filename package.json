{
  "name": "vorasaan",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "turbo run db:generate",
    "db:migrate": "bun run --filter @vorasaan/db db:migrate",
    "db:seed": "bun run --filter @vorasaan/db db:seed",
    "screenshots": "bun apps/web/scripts/screenshots/run.ts",
    "bench": "bun run --cwd apps/server bench"
  },
  "trustedDependencies": [
    "prisma",
    "@prisma/engines"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "turbo": "^2.11.5",
    "typescript": "^6.0.3"
  }
}
