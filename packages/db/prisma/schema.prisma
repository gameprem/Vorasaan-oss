// Vorasaan domain schema. Terms follow CONTEXT.md.
// Hierarchy: Organization -> Project -> Team -> Feature.
// Mastra keeps its workflow snapshots in a separate Postgres schema; nothing here depends on it.

// Connection URL lives in prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum OrgRole {
  ADMIN
  MEMBER
}

enum TeamRole {
  PO
  DESIGNER
  TECH_LEAD
  BACKEND
  FRONTEND
  MOBILE
  QA
}

enum FeatureStatus {
  DRAFT
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum IntegrationProvider {
  ANTHROPIC // Claude API
  OPENAI // OpenAI API (GPT and Codex models)
  OPENAI_COMPATIBLE // any OpenAI-compatible URL + token, e.g. 9Router
  OPENROUTER // OpenRouter: a key only, its base URL is fixed (ticket 0064)
  ATLASSIAN
  EMBEDDINGS // OpenAI-compatible embeddings endpoint for retrieval (ADR 0007)
  LINE // LINE Messaging API channel (ADR 0011): channel access token + channel secret
  SLACK // Slack app: bot token + signing secret
  TEAMS // Microsoft Teams bot: app id (in appId) + password
}

// A chat app a person can link to their account (ADR 0011, ticket 0057).
enum ChatProvider {
  LINE
  SLACK
  TEAMS
}

// What a person may receive in their linked chat app (ticket 0057; cards arrive with 0058).
enum ChatEventKind {
  DECISION_REQUEST // a Decision Request sent to them, to decide
  NEEDS_INFO // a request for more info on a Decision Request they raised
  SPEC_PROPOSAL // a Spec Proposal to approve (only a link: a diff needs a real screen)
  ESCALATION // Response Window reminders and overdue notices
}

enum AttachmentSource {
  FILE
  URL
  CONFLUENCE
  JIRA
  REPO_SCAN // a Repo Scan summary sent by `vorasaan scan`; no file, can't be refreshed
}

enum SpecVersionSource {
  MANUAL // PO edited in the web editor
  AI_SUMMARY // AI draft from Attachments, approved by a human
  DECISION // AI draft after a Decision, approved by the Decider
  REVERT // rolled back to an earlier version
  CONVERSATION // AI draft from a Conversation's Action Card, approved by a human
  ACCEPTANCE_CRITERIA // AI draft of a Platform's acceptance criteria (Coverage), approved by a human
}

enum BriefVersionSource {
  MANUAL // edited by hand
  GRILLING // AI draft from Grilling answers, approved by a human
  REVERT // rolled back to an earlier version
  CONVERSATION // AI draft from a Conversation's Action Card, approved by a human
}

enum GuidelineCriterionKind {
  KPI // a measurable goal the Feature should move
  CONSTRAINT // something the Feature must respect
  REQUIRED_SECTION // a section the Feature's Spec must contain
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DecisionRequestKind {
  BLOCKER // stops the Raiser's work; marks the Feature as Blocked
  QUESTION // Raiser keeps working
}

enum DecisionRequestStatus {
  DRAFT // Choices generated, Raiser still reviewing
  OPEN // waiting for a Decider (or a Claim)
  NEEDS_INFO // Decider asked the Raiser a question
  DECIDED // Decision made; terminal if no Spec change is needed
  SPEC_UPDATED // Spec Proposal approved, new Spec Version created
  WITHDRAWN
}

enum RequestContextKind {
  TEXT
  FILE
  DIFF
}

enum RequestMessageKind {
  QUESTION // Decider -> Raiser (NEEDS_INFO)
  ANSWER // Raiser -> Decider
  NOTE
}

// What a ContentChunk was cut from.
enum GrillingStatus {
  RUNNING // asking a round; at most one per Project
  DRAFTED // every round done; its Brief Proposal awaits the starter
  CANCELLED // stopped by the starter or an Admin; no Brief Version comes of it
}

enum GrillingRoundKind {
  BUSINESS // asked to the Project's POs
  UX // asked to its Designers
  TECHNICAL // asked to its Tech Leads
}

enum GrillingRoundStatus {
  ASKING // questions wait for answers; at most one per Grilling
  ANSWERED
  SKIPPED
}

enum GrillingSkipReason {
  NO_ONE_WITH_ROLE // nobody in the Project's Teams holds the round's Team Role
  NOTHING_TO_ASK // what is already known answers the round
  BY_STARTER // skipped by the starter or an Admin
}

enum ChunkSource {
  ATTACHMENT // its current Snapshot
  SPEC_VERSION // the Feature's latest Spec Version only
  DECISION // with its Decision Request and rationale
  BRIEF_VERSION // the Project's latest Brief Version only
}

// Informational only. Inbox Items are derived from DecisionRequest/SpecProposal state.
enum NotificationType {
  REQUEST_DECIDED // to the Raiser
  REQUEST_CLAIMED // to the other recipients
  REQUEST_WITHDRAWN // to the Decider or recipients
  SPEC_VERSION_CREATED // to the Feature's PO Role Owners
  DELEGATION_STARTED // to the Delegate
  REQUEST_REMINDER // escalation step 1: to the Decider, or the Recipients while nobody has Claimed it
  REQUEST_ESCALATED // escalation step 2: to each active Delegate added as a Recipient
  REQUEST_OVERDUE // escalation step 3: to the Raiser and the Team's Tech Leads
  AI_BUDGET_WARNING // the AI's estimated cost this month passed 80% of the budget: to the Admins (ticket 0075)
  AI_BUDGET_REACHED // ... and 100%; nothing is blocked
}

// How a Response Window is counted (ADR 0011): in working hours or working days of the
// Organization's calendar. A working day is as long as the working hours of one day.
enum ResponseWindowUnit {
  WORKING_HOURS
  WORKING_DAYS
}

// The steps of a Decision Request's escalation, written to its history (ticket 0055).
enum RequestHistoryKind {
  REMINDED // 1: the Recipients were reminded
  DELEGATES_ADDED // 2: each Recipient's active Delegate became a Recipient
  OVERDUE_REPORTED // 3: the Raiser and the Team's Tech Leads were told it is overdue
}

// How someone became the Decider of a Decision Request after it was sent (ticket 0056).
enum DeciderChangeKind {
  CLAIMED // a Claim, explicit or implied by asking a QUESTION or deciding
  REASSIGNED // the Decider handed it to someone else holding the role
}

// Where a Decision was made (ticket 0058): the web app, the CLI, or a button in a Chat App.
enum DecisionSource {
  WEB
  CLI
  LINE
  SLACK
  TEAMS
}

// A card for a person's Chat Account (ticket 0058).
enum ChatCardStatus {
  PENDING // waiting for the person's Quiet Hours to end
  SENT
  SKIPPED // no longer relevant when its turn came (decided, withdrawn, unlinked, preference off)
  FAILED // the chat app refused it; the Inbox still has it
}

// ─── Identity & access ──────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orgMemberships  OrgMembership[]
  teamMemberships TeamMembership[]
  roleOwnerships  RoleOwner[]
  sessions        Session[]
  accessTokens    PersonalAccessToken[]
  chatAccounts    ChatAccount[]
  chatLinkCodes   ChatLinkCode[]
  chatPreference  ChatPreference?
  chatCards       ChatCard[]
  notifications   Notification[]
  invitationsSent Invitation[]
  attachments     Attachment[]

  requestsRaised           DecisionRequest[]  @relation("RequestRaiser")
  requestsDeciding         DecisionRequest[]  @relation("RequestDecider")
  requestsReceived         RequestRecipient[] @relation("RecipientUser")
  requestsReceivedOnBehalf RequestRecipient[] @relation("RecipientOnBehalfOf")
  requestMessages          RequestMessage[]
  decisionsMade            Decision[]         @relation("DecisionDecidedBy")
  decisionsDelegated       Decision[]         @relation("DecisionOnBehalfOf")
  deciderChanges           DeciderChange[]

  proposalsToApprove SpecProposal[] @relation("ProposalApprover")
  specVersions       SpecVersion[]  @relation("SpecVersionApprovedBy")

  briefProposalsToApprove BriefProposal[] @relation("BriefProposalApprover")
  briefVersions           BriefVersion[]  @relation("BriefVersionApprovedBy")

  grillingsStarted Grilling[]         @relation("GrillingStartedBy")
  grillingAnswers  GrillingQuestion[] @relation("GrillingAnsweredBy")

  featureSuggestionsGenerated FeatureSuggestion[] @relation("FeatureSuggestionGeneratedBy")
  featureSuggestionsDecided   FeatureSuggestion[] @relation("FeatureSuggestionDecidedBy")

  conversations Conversation[]           @relation("ConversationOwner")
  compactions   ConversationCompaction[] @relation("ConversationCompactedBy")

  redraftsRequested Redraft[] @relation("RedraftRequestedBy")

  receipts        Receipt[]        @relation("ReceiptRequestedBy")
  receiptOutcomes ReceiptOutcome[] @relation("ReceiptOutcomeBy")

  promptVersionsProposed PromptVersion[]    @relation("PromptVersionProposedBy")
  promptVersionsApproved PromptVersion[]    @relation("PromptVersionApprovedBy")
  promptVersionsDeclined PromptVersion[]    @relation("PromptVersionDeclinedBy")
  promptActivations      PromptActivation[] @relation("PromptActivationBy")
  promptEvalRuns         PromptEvalRun[]    @relation("PromptEvalRunStartedBy")
  promptAnalyses         PromptAnalysis[]   @relation("PromptAnalysisRequestedBy")

  delegationsGiven    Delegation[] @relation("DelegationDelegator")
  delegationsReceived Delegation[] @relation("DelegationDelegate")
  delegationsCreated  Delegation[] @relation("DelegationCreatedBy")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// CLI auth for the MVP. Browser-based `vorasaan login` comes later.
model PersonalAccessToken {
  id         String    @id @default(uuid())
  userId     String
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Organization ───────────────────────────────────────────────────────────

// One per self-hosted instance for now; kept as a model so SaaS stays possible.
model Organization {
  id                   String   @id @default(uuid())
  name                 String
  // "en" or "th" (tickets 0063, 0068): the language of chat app cards, bot replies, Grilling
  // texts and AI replies for anyone who hasn't picked their own, and of Project-wide AI output.
  language             String   @default("en")
  // Receipts (ADR 0015, ticket 0070): whether every AI call leaves one, and for how many
  // days they are kept. Turning collection off stops new ones; old ones follow retention.
  receiptsEnabled      Boolean  @default(true)
  receiptRetentionDays Int      @default(90)
  // The AI analyses a prompt's feedback once this many new outcomes are linked to its
  // Receipts (ticket 0072); 0 never analyses on its own (an Admin still can).
  promptAnalysisAfter  Int      @default(20)
  // A monthly budget for the AI's estimated cost, in US dollars (ticket 0075); null: none.
  // The Admins get a Notification at 80% and at 100% of it. Nothing is ever blocked.
  aiMonthlyBudget      Float?
  createdAt            DateTime @default(now())

  memberships       OrgMembership[]
  invitations       Invitation[]
  integrations      OrgIntegration[]
  approvedModels    ApprovedModel[]
  aiTaskModels      AiTaskModel[]
  projects          Project[]
  chunks            ContentChunk[]
  guidelines        GuidelineCriterion[]
  chatAccounts      ChatAccount[]
  chatLinkCodes     ChatLinkCode[]
  responseWindow    ResponseWindowSettings?
  holidays          OrgHoliday[]
  promptVersions    PromptVersion[]
  promptActivations PromptActivation[]
  promptEvalRuns    PromptEvalRun[]
  promptAnalyses    PromptAnalysis[]
  aiBudgetAlerts    AiBudgetAlert[]
  platformTemplate  OrgPlatformTemplate[]
}

// One AI budget threshold (80 or 100 percent) crossed in one month of the Organization's
// time zone (ticket 0075): its Notification went to the Admins. The key keeps it to one
// each, however many Receipts cross it at once. Changing the budget clears the month's.
model AiBudgetAlert {
  organizationId String
  month          String // "2026-10", in the Organization's Working Time zone
  threshold      Int // 80 or 100
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, month, threshold])
}

// The Organization's working calendar and default Response Windows (ADR 0011).
// No row: the defaults (UTC, Monday to Friday 09:00-18:00, Blocker 4 working hours,
// Question 2 working days).
model ResponseWindowSettings {
  organizationId     String             @id
  timeZone           String // IANA name, e.g. Asia/Bangkok
  workingDays        Int[] // ISO weekdays: 1 = Monday ... 7 = Sunday
  workStartMinute    Int // minutes after local midnight, e.g. 540 = 09:00
  workEndMinute      Int // after workStartMinute
  blockerWindow      Int
  blockerWindowUnit  ResponseWindowUnit
  questionWindow     Int
  questionWindowUnit ResponseWindowUnit
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// A public holiday the Admin maintains: no working time that day.
model OrgHoliday {
  id             String       @id @default(uuid())
  organizationId String
  date           DateTime     @db.Date
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
}

model OrgMembership {
  id                        String       @id @default(uuid())
  organizationId            String
  userId                    String
  role                      OrgRole      @default(MEMBER)
  // When this Admin dismissed the Getting started checklist (ticket 0063); null: not yet.
  gettingStartedDismissedAt DateTime?
  createdAt                 DateTime     @default(now())
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  email          String
  role           OrgRole      @default(MEMBER)
  tokenHash      String       @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User         @relation(fields: [invitedById], references: [id])

  @@index([organizationId, email])
}

// LLM providers, Atlassian and embeddings credentials, set by an Admin in /setup or settings.
model OrgIntegration {
  id              String              @id @default(uuid())
  organizationId  String
  provider        IntegrationProvider
  name            String? // LLM providers: the Admin's label, e.g. "Anthropic" or "Local 9Router"
  baseUrl         String?
  accountEmail    String? // Atlassian API tokens are paired with an email
  model           String? // EMBEDDINGS: the embedding model. LLM models are Approved Models.
  appId           String? // TEAMS: the bot's Microsoft app id (the JWT audience); not a secret
  // Chat apps: a JSON object of the provider's secrets, encrypted as one value.
  secretEncrypted String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvedModels  ApprovedModel[]

  // An Organization may connect several LLM providers (ADR 0010), but at most one
  // ATLASSIAN, EMBEDDINGS, LINE, SLACK and TEAMS integration (partial unique indexes
  // in the migrations).
  @@index([organizationId, provider])
}

// An AI model an Admin allows people to use (ADR 0010): a provider plus a model id,
// with a name people recognize. Exactly one per Organization is the default
// (at most one by a partial unique index in the migration; the service keeps one).
model ApprovedModel {
  id             String         @id @default(uuid())
  organizationId String
  integrationId  String // the LLM provider it runs on; a provider with models can't be deleted
  modelId        String // the provider's model name, e.g. claude-opus-5-5
  displayName    String // e.g. "Fast", "Best", "Local (no data leaves)"
  note           String?
  // How many tokens one call to it may hold, prompt and reply together (ticket 0060):
  // prefilled for known models, else VORASAAN_CONTEXT_WINDOW; an Admin can edit it.
  contextWindow  Int
  // What a million tokens cost on it, in US dollars, as the Admin set them (ticket 0075):
  // the AI usage dashboard's estimated cost. Both null: no cost is shown, only tokens.
  inputPricePerMillion  Float?
  outputPricePerMillion Float?
  position       Int
  isDefault      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration    OrgIntegration @relation(fields: [integrationId], references: [id], onDelete: NoAction)
  taskModels     AiTaskModel[]
  conversations  Conversation[] // picked in them (ticket 0054)

  @@unique([organizationId, displayName])
  @@index([organizationId, position])
  @@index([integrationId])
}

// The AI tasks an Admin can set a model for. Each groups one or more AI calls.
enum AiTaskKind {
  CHOICES // a Decision Request's Choices
  SPEC_PROPOSAL // Spec Proposals: after a Decision, from Attachments, from a Feature Suggestion
  SUMMARIES // Attachment summaries and Conversation summaries
  GRILLING // Grilling questions and the Brief Proposal drafted from the answers
  FEATURE_SUGGESTIONS
  FIT_CHECK // a new Feature against the Feature Guidelines
  CHAT // Conversation replies
  PROMPT_PROPOSALS // the AI reading feedback and proposing Prompt Versions (ticket 0072)
}

// The Approved Model an AI task uses. No row: the default Approved Model.
// Removing the model removes the row, so the task falls back to the default.
model AiTaskModel {
  id              String        @id @default(uuid())
  organizationId  String
  task            AiTaskKind
  approvedModelId String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvedModel   ApprovedModel @relation(fields: [approvedModelId], references: [id], onDelete: Cascade)

  @@unique([organizationId, task])
  @@index([approvedModelId])
}

// ─── Project / Team / Feature ───────────────────────────────────────────────

// A product (e.g. "Mobile Banking"). Maps to a Jira project.
model Project {
  id                 String               @id @default(uuid())
  organizationId     String
  name               String
  jiraKey            String?
  // The Project's own default Response Windows; null keeps the Organization's (ADR 0011).
  blockerWindow      Int?
  blockerWindowUnit  ResponseWindowUnit?
  questionWindow     Int?
  questionWindowUnit ResponseWindowUnit?
  createdAt          DateTime             @default(now())
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teams              Team[]
  chunks             ContentChunk[]
  attachments        Attachment[] // Project-level Attachments (not on a Feature)
  briefVersions      BriefVersion[]
  briefProposals     BriefProposal[]
  guidelines         GuidelineCriterion[]
  grillings          Grilling[]
  suggestions        FeatureSuggestion[]
  conversations      Conversation[]
  platforms          Platform[]

  @@unique([organizationId, name])
  @@unique([organizationId, jiraKey])
}

model Team {
  id          String           @id @default(uuid())
  projectId   String
  name        String
  createdAt   DateTime         @default(now())
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members     TeamMembership[]
  features    Feature[]
  delegations Delegation[]

  @@unique([projectId, name])
}

// A Team Role may be held by many people; a person may hold several Team Roles.
model TeamMembership {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      TeamRole
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, role])
  @@index([teamId, role])
}

// Someone deciding on another person's behalf for a period (e.g. leave).
// Set by the delegator or an Admin; the Delegate must hold the same Team Role in the Team.
model Delegation {
  id          String        @id @default(uuid())
  teamId      String
  role        TeamRole
  delegatorId String
  delegateId  String
  startsAt    DateTime
  endsAt      DateTime
  createdById String
  createdAt   DateTime      @default(now())
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  delegator   User          @relation("DelegationDelegator", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegate    User          @relation("DelegationDelegate", fields: [delegateId], references: [id], onDelete: Cascade)
  createdBy   User          @relation("DelegationCreatedBy", fields: [createdById], references: [id])
  started     Notification? // DELEGATION_STARTED, to the Delegate

  @@index([delegatorId, teamId, role, startsAt, endsAt])
}

model Feature {
  id           String        @id @default(uuid())
  teamId       String
  title        String
  description  String?
  status       FeatureStatus @default(DRAFT)
  jiraIssueKey String? // optional, read-only link to a Jira Epic
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  roleOwners       RoleOwner[]
  attachments      Attachment[]
  specVersions     SpecVersion[]
  specProposals    SpecProposal[]
  decisionRequests DecisionRequest[]
  notifications    Notification[]
  chunks           ContentChunk[]
  suggestion       FeatureSuggestion? // the Feature Suggestion it was accepted from, if any
  conversations    Conversation[]
  platforms        FeaturePlatform[] // the Platforms it targets (ADR 0009)

  @@index([teamId])
  @@index([jiraIssueKey])
}

// ─── Platforms (ADR 0009, ticket 0050) ──────────────────────────────────────

// A part of the product a Feature can ship on, in its Project's own ordered list (copied
// from the Organization's default when the Project is created). `roles` are the Team
// Roles who can answer for it; the four booleans are the Coverage checks it switches on.
// Names are unique per Project ignoring case (a unique index on lower(name) in the
// migration), since a Spec section matches its name case-insensitively.
model Platform {
  id             String            @id @default(uuid())
  projectId      String
  name           String
  position       Int
  roles          TeamRole[]
  specSection    Boolean           @default(true)
  someoneToAsk   Boolean           @default(true)
  noOpenBlockers Boolean           @default(true)
  qaReady        Boolean           @default(true)
  createdAt      DateTime          @default(now())
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  features       FeaturePlatform[]

  @@index([projectId, position])
}

// A Feature targets a Platform of its own Project (checked by the service). Removing a
// Platform that Features target is refused by the service, which names them; the cascade
// is only for deleting a whole Project (a NO ACTION key would trip on its cascade order).
model FeaturePlatform {
  featureId  String
  platformId String
  createdAt  DateTime @default(now())
  feature    Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@id([featureId, platformId])
  @@index([platformId])
}

// One entry of the Organization's default Platform list, copied into each new Project.
// No rows: the built-in template (Back-End, Front-End, Mobile) is the default. Changing
// it never rewrites existing Projects.
model OrgPlatformTemplate {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  position       Int
  roles          TeamRole[]
  specSection    Boolean      @default(true)
  someoneToAsk   Boolean      @default(true)
  noOpenBlockers Boolean      @default(true)
  qaReady        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, position])
}

// A Feature may have several Role Owners for the same Team Role.
model RoleOwner {
  id        String   @id @default(uuid())
  featureId String
  userId    String
  role      TeamRole
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([featureId, userId, role])
  @@index([userId])
}

// External docs on a Feature or on a Project (exactly one of featureId/projectId
// is set; a CHECK constraint in the migration enforces it). Content is
// snapshotted so the AI can use it as context; "Refresh" re-fetches.
model Attachment {
  id           String           @id @default(uuid())
  featureId    String?
  projectId    String?
  source       AttachmentSource
  title        String
  url          String?
  storageKey   String? // uploaded file location
  mimeType     String?
  snapshotText String?
  snapshotAt   DateTime?
  summary      String? // AI summary of the Snapshot; null when none or the AI call failed
  addedById    String
  createdAt    DateTime         @default(now())
  feature      Feature?         @relation(fields: [featureId], references: [id], onDelete: Cascade)
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addedBy      User             @relation(fields: [addedById], references: [id])

  @@index([featureId])
  @@index([projectId])
}

// ─── Spec ───────────────────────────────────────────────────────────────────

// Immutable. The highest version is the current Spec. Markdown is canonical (ADR 0002).
model SpecVersion {
  id             String            @id @default(uuid())
  featureId      String
  version        Int
  markdown       String
  source         SpecVersionSource
  summary        String? // one-line "what changed"
  approvedById   String
  proposalId     String?           @unique
  revertedFromId String?
  createdAt      DateTime          @default(now())
  feature        Feature           @relation(fields: [featureId], references: [id], onDelete: Cascade)
  approvedBy     User              @relation("SpecVersionApprovedBy", fields: [approvedById], references: [id])
  proposal       SpecProposal?     @relation(fields: [proposalId], references: [id])
  revertedFrom   SpecVersion?      @relation("SpecRevert", fields: [revertedFromId], references: [id])
  reverts        SpecVersion[]     @relation("SpecRevert")
  basedProposals SpecProposal[]    @relation("ProposalBase")
  notifications  Notification[]

  @@unique([featureId, version])
}

// AI-drafted change awaiting approval. An Inbox Item for `approverId` while PENDING.
model SpecProposal {
  id               String            @id @default(uuid())
  featureId        String
  baseVersionId    String? // null when drafting the first version
  source           SpecVersionSource // AI_SUMMARY, DECISION, CONVERSATION or ACCEPTANCE_CRITERIA
  proposedMarkdown String
  status           ProposalStatus    @default(PENDING)
  approverId       String // the Decider for DECISION, the requesting PO for AI_SUMMARY
  decisionId       String?           @unique
  reviewedAt       DateTime?
  // The model that drafted it in a Conversation (ticket 0054), as it was then: the
  // Approved Model (a plain id, so the record outlives it), its display name and
  // the provider's model id (or the env "provider/model"). Null when drafted elsewhere.
  approvedModelId  String?
  modelDisplayName String?
  modelName        String?
  createdAt        DateTime          @default(now())
  feature          Feature           @relation(fields: [featureId], references: [id], onDelete: Cascade)
  baseVersion      SpecVersion?      @relation("ProposalBase", fields: [baseVersionId], references: [id])
  decision         Decision?         @relation(fields: [decisionId], references: [id])
  approver         User              @relation("ProposalApprover", fields: [approverId], references: [id])
  resultVersion    SpecVersion?
  redrafts         Redraft[]

  @@index([approverId, status])
  @@index([featureId, status])
}

// ─── Project Brief (ADR 0006) ─────────────────────────────────────────────────

// Immutable. The highest version is the current Project Brief; a Project with no
// Brief Version shows the empty template as "v0".
model BriefVersion {
  id             String             @id @default(uuid())
  projectId      String
  version        Int
  markdown       String
  source         BriefVersionSource
  summary        String? // one-line "what changed"
  approvedById   String
  proposalId     String?            @unique
  revertedFromId String?
  createdAt      DateTime           @default(now())
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvedBy     User               @relation("BriefVersionApprovedBy", fields: [approvedById], references: [id])
  proposal       BriefProposal?     @relation("BriefProposalResult", fields: [proposalId], references: [id])
  revertedFrom   BriefVersion?      @relation("BriefRevert", fields: [revertedFromId], references: [id])
  reverts        BriefVersion[]     @relation("BriefRevert")
  basedProposals BriefProposal[]    @relation("BriefProposalBase")

  @@unique([projectId, version])
}

// A drafted change to the Project Brief (e.g. from Grilling), awaiting approval.
model BriefProposal {
  id               String             @id @default(uuid())
  projectId        String
  baseVersionId    String? // null when drafting the first version
  source           BriefVersionSource
  proposedMarkdown String
  summary          String? // one-line "what changed", copied to the Brief Version on approval
  status           ProposalStatus     @default(PENDING)
  approverId       String
  reviewedAt       DateTime?
  // The model that drafted it in a Conversation (ticket 0054), as it was then: the
  // Approved Model (a plain id, so the record outlives it), its display name and
  // the provider's model id (or the env "provider/model"). Null when drafted elsewhere.
  approvedModelId  String?
  modelDisplayName String?
  modelName        String?
  createdAt        DateTime           @default(now())
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  baseVersion      BriefVersion?      @relation("BriefProposalBase", fields: [baseVersionId], references: [id])
  approver         User               @relation("BriefProposalApprover", fields: [approverId], references: [id])
  resultVersion    BriefVersion?      @relation("BriefProposalResult")
  grilling         Grilling?
  redrafts         Redraft[]

  @@index([approverId, status])
  @@index([projectId, status])
}

// ─── Decision Requests ──────────────────────────────────────────────────────

// A Blocker or a Question. Inbox Items derive from it:
//   OPEN + deciderId = me                       -> decide
//   OPEN + deciderId null + I'm a recipient     -> claim / decide
//   NEEDS_INFO + raiserId = me                  -> answer
model DecisionRequest {
  id                      String                @id @default(uuid())
  featureId               String
  kind                    DecisionRequestKind
  withChoices             Boolean               @default(true) // false: plain-text Question
  raiserId                String
  title                   String
  description             String
  suggestedRole           TeamRole? // AI suggestion
  deciderRole             TeamRole // confirmed by the Raiser
  deciderId               String? // null until Claimed when sent to several recipients
  status                  DecisionRequestStatus @default(DRAFT)
  submittedAt             DateTime?
  closedAt                DateTime?
  // Response Window (ADR 0011, ticket 0055). Set on submit: the window in working
  // minutes and when it runs out. While NEEDS_INFO the clock is paused (`pausedAt`);
  // the answer moves `dueAt` later by the working time spent waiting.
  responseWindowMinutes   Int?
  dueAt                   DateTime?
  pausedAt                DateTime?
  // How far escalation has gone: 0 none, 1 reminded, 2 Delegates added, 3 overdue reported.
  escalationStep          Int                   @default(0)
  // The model that drafted its AI Choices in a Conversation (ticket 0054), as it
  // was then (see SpecProposal). Null when raised elsewhere.
  choicesApprovedModelId  String?
  choicesModelDisplayName String?
  choicesModelName        String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  feature                 Feature               @relation(fields: [featureId], references: [id], onDelete: Cascade)
  raiser                  User                  @relation("RequestRaiser", fields: [raiserId], references: [id])
  decider                 User?                 @relation("RequestDecider", fields: [deciderId], references: [id])

  recipients     RequestRecipient[]
  contexts       RequestContext[]
  choices        Choice[]
  messages       RequestMessage[]
  decision       Decision?
  notifications  Notification[]
  history        RequestHistoryEntry[]
  deciderChanges DeciderChange[]
  chatCards      ChatCard[]
  redrafts       Redraft[] // of its Choices (ticket 0065)

  @@index([featureId, kind, status])
  @@index([status, dueAt])
  @@index([deciderId, status])
  @@index([raiserId, status])
}

// Who the Raiser sent the request to (one Role Owner, or all of them for the role).
// Resolved through active Delegations at send time.
model RequestRecipient {
  id           String          @id @default(uuid())
  requestId    String
  userId       String
  onBehalfOfId String? // the delegator, when this recipient replaced them as their Delegate
  request      DecisionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user         User            @relation("RecipientUser", fields: [userId], references: [id], onDelete: Cascade)
  onBehalfOf   User?           @relation("RecipientOnBehalfOf", fields: [onBehalfOfId], references: [id], onDelete: SetNull)

  @@unique([requestId, userId])
  @@index([userId])
  @@index([onBehalfOfId])
}

// One escalation step of a Decision Request, at most once each (ticket 0055).
// `people` snapshots who was reminded, added or told, as [{ id, name }].
model RequestHistoryEntry {
  id        String             @id @default(uuid())
  requestId String
  kind      RequestHistoryKind
  people    Json
  createdAt DateTime
  request   DecisionRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, kind])
}

// Each time a sent Decision Request got a new Decider, and when (ticket 0056). Decision
// Lead Time attributes the wait to the routed Recipients until the first one, then to
// whoever it names. A request may be Claimed or reassigned several times.
model DeciderChange {
  id        String            @id @default(uuid())
  requestId String
  deciderId String // the new Decider
  kind      DeciderChangeKind
  createdAt DateTime
  request   DecisionRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  decider   User              @relation(fields: [deciderId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

// Local context sent from the CLI (--file, --diff) or pasted text.
model RequestContext {
  id        String             @id @default(uuid())
  requestId String
  kind      RequestContextKind
  path      String?
  content   String
  request   DecisionRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// 2-4 per request, editable by the Raiser while DRAFT.
model Choice {
  id           String          @id @default(uuid())
  requestId    String
  position     Int
  label        String // "A", "B", ...
  title        String
  description  String
  impactScope  String
  impactTime   String
  impactRisk   String
  editedByUser Boolean         @default(false)
  request      DecisionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  decisions    Decision[]

  @@unique([requestId, position])
}

model RequestMessage {
  id        String             @id @default(uuid())
  requestId String
  authorId  String
  kind      RequestMessageKind
  body      String
  createdAt DateTime           @default(now())
  request   DecisionRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User               @relation(fields: [authorId], references: [id])

  @@index([requestId, createdAt])
}

// A Decision Log entry: a picked Choice or a free-text answer.
model Decision {
  id           String          @id @default(uuid())
  requestId    String          @unique
  decidedById  String
  onBehalfOfId String? // set when decided as a Delegate
  choiceId     String?
  customAnswer String?
  rationale    String?
  source       DecisionSource  @default(WEB) // the web app, the CLI or a Chat App button
  createdAt    DateTime        @default(now())
  request      DecisionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  decidedBy    User            @relation("DecisionDecidedBy", fields: [decidedById], references: [id])
  onBehalfOf   User?           @relation("DecisionOnBehalfOf", fields: [onBehalfOfId], references: [id])
  choice       Choice?         @relation(fields: [choiceId], references: [id])
  specProposal SpecProposal?
}

// ─── Notifications ──────────────────────────────────────────────────────────

// Informational messages with read state. Streamed to web and CLI (SSE, OS notifications).
model Notification {
  id            String           @id @default(uuid())
  userId        String
  type          NotificationType
  featureId     String?
  requestId     String?
  specVersionId String?
  delegationId  String?          @unique // DELEGATION_STARTED only: one per Delegation, written lazily
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature       Feature?         @relation(fields: [featureId], references: [id], onDelete: Cascade)
  request       DecisionRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  specVersion   SpecVersion?     @relation(fields: [specVersionId], references: [id], onDelete: Cascade)
  delegation    Delegation?      @relation(fields: [delegationId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// ─── Retrieval (ADR 0007) ───────────────────────────────────────────────────

// A piece of long content, embedded for retrieval. Rows are replaced whenever their
// source is re-indexed. `embedding` is a pgvector `vector` of any dimension; it is
// null when no embeddings provider is configured or the call failed. Vector reads,
// writes and search are raw SQL in ContentChunkRepository only. Each dimension in
// use gets a partial HNSW index, created on first use:
//   USING hnsw ((embedding::vector(N)) vector_cosine_ops) WHERE "embeddingDims" = N
model ContentChunk {
  id             String                 @id @default(uuid())
  organizationId String
  projectId      String
  featureId      String?
  source         ChunkSource
  sourceId       String
  position       Int
  text           String
  tokenCount     Int
  embedding      Unsupported("vector")?
  embeddingModel String? // the model that produced `embedding`; vectors of different models are never compared
  embeddingDims  Int?
  createdAt      DateTime               @default(now())
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feature        Feature?               @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([source, sourceId, position])
  @@index([organizationId, projectId, featureId])
  @@index([featureId])
}

// One criterion of the Feature Guidelines (ADR 0006). With projectId null it is
// part of the Organization default. With a projectId it is a Project override:
// an addition (overridesId null), an edit of a default criterion (overridesId
// set), or a default criterion hidden in that Project (overridesId set,
// disabled). A disabled row keeps a copy of the default's text, unused.
model GuidelineCriterion {
  id             String                 @id @default(uuid())
  organizationId String
  projectId      String?
  overridesId    String?
  title          String
  description    String
  kind           GuidelineCriterionKind
  required       Boolean
  disabled       Boolean                @default(false)
  position       Int
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Removing a default criterion removes the Projects' edits and hides of it.
  overrides      GuidelineCriterion?    @relation("GuidelineOverride", fields: [overridesId], references: [id], onDelete: Cascade)
  overriddenBy   GuidelineCriterion[]   @relation("GuidelineOverride")

  @@unique([projectId, overridesId])
  @@index([organizationId, projectId, position])
}

// Grilling (ADR 0006, ticket 0032): rounds of AI-asked questions (business, UX,
// technical) to the people holding each round's Team Role in the Project's
// Teams, drafted into a Brief Proposal for the starter to approve. It spans days
// and many people, so its whole state lives here rather than in a Mastra
// workflow snapshot. `memory` is a WorkflowMemory (short summaries of the
// rounds done), sent back to the AI instead of the whole transcript.
// At most one RUNNING Grilling per Project (partial unique index in the migration).
model Grilling {
  id           String             @id @default(uuid())
  projectId    String
  startedById  String
  status       GrillingStatus     @default(RUNNING)
  currentRound GrillingRoundKind? // the round being asked while RUNNING
  memory       Json
  revision     Int                @default(0) // bumped by every change; guards concurrent writes
  proposalId   String?            @unique
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startedBy    User               @relation("GrillingStartedBy", fields: [startedById], references: [id])
  proposal     BriefProposal?     @relation(fields: [proposalId], references: [id])
  rounds       GrillingRound[]
  questions    GrillingQuestion[]

  @@index([projectId, createdAt])
}

// One round of a Grilling, created when it is reached. At most one ASKING per
// Grilling (partial unique index in the migration).
model GrillingRound {
  id            String              @id @default(uuid())
  grillingId    String
  kind          GrillingRoundKind
  role          TeamRole // who answers: PO, DESIGNER or TECH_LEAD
  status        GrillingRoundStatus
  skipReason    GrillingSkipReason?
  createdAt     DateTime            @default(now())
  completedAt   DateTime?
  grilling      Grilling            @relation(fields: [grillingId], references: [id], onDelete: Cascade)
  questions     GrillingQuestion[]
  // Each holder's own Grilling Conversation for this round (ticket 0044).
  conversations Conversation[]

  @@unique([grillingId, kind])
  @@index([status, role])
}

model GrillingQuestion {
  id           String        @id @default(uuid())
  grillingId   String
  roundId      String
  position     Int
  text         String
  answer       String?
  answeredById String?
  answeredAt   DateTime?
  skipped      Boolean       @default(false) // left unanswered when its round was skipped
  // The follow-ups the AI asked the answerer in their Grilling Conversation, and
  // their replies, as [{ question, answer }] (ticket 0044). Null when answered without.
  followUps    Json?
  createdAt    DateTime      @default(now())
  grilling     Grilling      @relation(fields: [grillingId], references: [id], onDelete: Cascade)
  round        GrillingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  answeredBy   User?         @relation("GrillingAnsweredBy", fields: [answeredById], references: [id])

  @@unique([roundId, position])
  @@index([grillingId])
}

// ─── Feature Suggestions (ADR 0006, ticket 0034) ──────────────────────────────

enum FeatureSuggestionStatus {
  PENDING
  ACCEPTED // a Feature was created from it (featureId)
  DISMISSED // with a reason, sent back to the AI on the next generation
}

// A rough level, for a Feature Suggestion's effort and risk.
enum SuggestionLevel {
  LOW
  MEDIUM
  HIGH
}

// A Feature the AI proposes from the Project Brief, the Feature Guidelines, the
// Project's existing Features and the Decision Log. Suggestions generated together
// share a batchId. `servesGuidelineIds` are the effective Guidelines criteria it
// serves, as they were when it was generated (a criterion may be gone since).
model FeatureSuggestion {
  id                 String                  @id @default(uuid())
  projectId          String
  batchId            String
  title              String
  rationale          String
  businessValue      String
  effort             SuggestionLevel
  risk               SuggestionLevel
  servesGuidelineIds String[]
  status             FeatureSuggestionStatus @default(PENDING)
  dismissReason      String?
  decidedById        String?
  decidedAt          DateTime?
  featureId          String?                 @unique
  generatedById      String
  createdAt          DateTime                @default(now())
  project            Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feature            Feature?                @relation(fields: [featureId], references: [id], onDelete: SetNull)
  generatedBy        User                    @relation("FeatureSuggestionGeneratedBy", fields: [generatedById], references: [id])
  decidedBy          User?                   @relation("FeatureSuggestionDecidedBy", fields: [decidedById], references: [id])
  redrafts           Redraft[]

  @@index([projectId, status, createdAt])
}

// ─── Conversations (ADR 0008, ticket 0042) ────────────────────────────────────

enum ConversationMessageRole {
  USER // what the owner wrote
  ASSISTANT // the AI's reply, stored once its stream completed
  TOOL // a tool's result for the AI's next step (Action Cards, ticket 0043)
}

// A person's chat with the AI about a Project, or about one of its Features
// (featureId set; projectId is then the Feature's Project). Only its owner reads
// it. Each turn the AI gets `summary` (the messages before `summarizedThrough`,
// folded together) plus the messages from it on, never the whole history (ADR 0007).
model Conversation {
  id                  String                   @id @default(uuid())
  ownerId             String
  projectId           String
  featureId           String?
  title               String
  summary             String                   @default("")
  summarizedThrough   Int                      @default(0) // messages with a lower position are in `summary`
  // Set on a Grilling Conversation (ticket 0044): the round its owner answers here.
  // One per person and round; always a Project Conversation.
  grillingRoundId     String?
  // Where a Grilling Conversation stands: the question being asked, the answer
  // and follow-ups so far, the questions its owner skipped (GrillingThreadState).
  grillingState       Json?
  // The Approved Model picked in it (ticket 0054), kept for its next messages.
  // Null until someone picks one, or once it is removed: then the chat default.
  modelId             String?
  // The last reply's input tokens and the part read from the provider's cache
  // (tickets 0061, 0066), summed over the turn's steps; null until a provider reports them.
  lastInputTokens     Int?
  lastCacheReadTokens Int?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt // bumped by every message
  owner               User                     @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  project             Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feature             Feature?                 @relation(fields: [featureId], references: [id], onDelete: Cascade)
  grillingRound       GrillingRound?           @relation(fields: [grillingRoundId], references: [id], onDelete: Cascade)
  model               ApprovedModel?           @relation(fields: [modelId], references: [id], onDelete: SetNull)
  messages            ConversationMessage[]
  actionCards         ActionCard[]
  compactions         ConversationCompaction[]

  @@unique([grillingRoundId, ownerId])
  @@index([ownerId, updatedAt])
  @@index([modelId])
  @@index([projectId])
  @@index([featureId])
}

// One message of a Conversation, numbered from 0 in the order written.
// `toolCalls` (ASSISTANT) holds the tools the AI called, as [{ id, name, args }];
// `toolCallId` (TOOL) names the call a result answers. Action Cards (0043) point
// at the message that made them.
model ConversationMessage {
  id               String                  @id @default(uuid())
  conversationId   String
  position         Int
  role             ConversationMessageRole
  content          String
  toolCalls        Json?
  toolCallId       String?
  // ASSISTANT: the model that wrote it (ticket 0054), as it was then (see
  // SpecProposal). Null for the server's own messages (Grilling questions).
  approvedModelId  String?
  modelDisplayName String?
  modelName        String?
  // ASSISTANT: on the one reply after the Conversation's model was removed, what it used instead.
  modelNotice      String?
  // ASSISTANT, in a Grilling Conversation: what the server wrote, as Grilling Notes
  // (ticket 0047, `GrillingNote` in @vorasaan/shared), so it can be shown in the
  // reader's language. `content` holds the same in English.
  grillingNotes    Json?
  createdAt        DateTime                @default(now())
  conversation     Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actionCards      ActionCard[] // made by this ASSISTANT message's tool calls

  @@unique([conversationId, position])
}

enum ConversationCompactionTrigger {
  AUTO // a turn found the history past its threshold
  MANUAL // a person: "Compact now" or /compact
  TOO_LONG // the provider rejected a request as too long
}

// One fold of a Conversation's history into its Conversation Summary (tickets
// 0060, 0066). The messages stay stored; the web draws a divider above the
// message at `summarizedThrough`. `summary` is the Conversation Summary as this
// fold left it, so each divider shows its own.
model ConversationCompaction {
  id                String                        @id @default(uuid())
  conversationId    String
  number            Int // 1, 2, 3… per Conversation
  trigger           ConversationCompactionTrigger
  focus             String? // MANUAL: what the person asked the summary to keep
  summarizedThrough Int // messages with a lower position are in `summary`
  summary           String
  createdById       String? // MANUAL: who compacted
  createdAt         DateTime                      @default(now())
  conversation      Conversation                  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy         User?                         @relation("ConversationCompactedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([conversationId, number])
  @@index([createdById])
}

// ─── Action Cards (ADR 0008, ticket 0043) ───────────────────────────────────

enum ActionCardKind {
  DECISION_REQUEST // a DRAFT Decision Request; approving sends it
  SPEC_PROPOSAL // a PENDING Spec Proposal; approving makes the next Spec Version
  BRIEF_PROPOSAL // a PENDING Brief Proposal; approving makes the next Brief Version
  FEATURE_SUGGESTION // a PENDING Feature Suggestion; approving accepts it
}

enum ActionCardStatus {
  PROPOSED // waiting for the Conversation's owner
  APPROVED // approved through the target's own service
  DECLINED // withdrawn, rejected or dismissed through the target's own service
  STALE // the target changed elsewhere, so the card can no longer be acted on
}

model ActionCard {
  id             String              @id @default(uuid())
  conversationId String
  messageId      String // the ASSISTANT message whose tool call made it
  toolCallId     String
  kind           ActionCardKind
  targetId       String // the Decision Request, Spec Proposal, Brief Proposal or Feature Suggestion
  status         ActionCardStatus    @default(PROPOSED)
  title          String
  summary        String?
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([kind, targetId])
  @@index([conversationId, createdAt])
  @@index([messageId])
}

// ─── Chat apps (ADR 0011, ticket 0057) ──────────────────────────────────────

// A person's account in a chat app, linked with a one-time code. Messages and button
// presses from it count as that person; nothing else does.
model ChatAccount {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  provider       ChatProvider
  providerUserId String // LINE userId, Slack user id, Teams from.id
  // Where to send that person messages: Slack { teamId, channelId }; Teams
  // { serviceUrl, conversationId, tenantId, botId }; LINE {} (the user id is enough).
  address        Json
  displayName    String? // as the chat app reported it, when it does (Teams)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, providerUserId]) // one person per chat account
  @@unique([userId, provider]) // one chat account per person per chat app
}

// A one-time code a person sends to the bot to link their chat account. Only the
// SHA-256 of the code is stored; it is valid for 10 minutes and used once.
model ChatLinkCode {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  provider       ChatProvider
  codeHash       String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
}

// What a person receives in their chat apps, and when not. No row: the defaults
// (Decision Requests and NEEDS_INFO, no quiet hours).
model ChatPreference {
  userId           String          @id
  events           ChatEventKind[]
  quietStartMinute Int? // minutes after local midnight; both set or both null
  quietEndMinute   Int? // may be before the start: quiet hours across midnight
  timeZone         String? // IANA; null: the Organization's time zone
  language         String? // "en" or "th": the person's language (cards, bot replies, Grilling texts, AI replies, 0068); null: the Organization's
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A card for one person's Chat Account (ticket 0058): a Decision Request to decide, a
// NEEDS_INFO question to answer, an escalation notice, or a link to a Spec Proposal. Its
// buttons carry this row's id, signed, so a press is matched to the card and to the person
// it was sent to. Held back as PENDING during the person's Quiet Hours.
model ChatCard {
  id             String           @id @default(uuid())
  userId         String // who it is for; only their linked Chat Account may press it
  provider       ChatProvider
  event          ChatEventKind // which of the person's chat preferences it falls under
  requestId      String?
  specProposalId String?
  escalationStep Int? // 1-3 for an escalation card
  status         ChatCardStatus   @default(PENDING)
  // Where the chat app put it, to update it after a press: Slack { channel, ts };
  // Teams { serviceUrl, conversationId, activityId }. LINE can't edit a sent message.
  messageRef     Json?
  createdAt      DateTime
  sentAt         DateTime?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  request        DecisionRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([requestId])
}

// ─── Request changes and Redrafts (ADR 0013, ticket 0065) ───────────────────

// The AI proposals a person can Request changes on.
enum ProposalKind {
  CHOICES // a Decision Request's Choices (the request's id)
  SPEC_PROPOSAL
  BRIEF_PROPOSAL
  FEATURE_SUGGESTION
  PROMPT_VERSION // a Prompt Version the AI proposed (ticket 0072)
}

enum RedraftStatus {
  WRITING // the AI is writing it: Approve and another Request changes wait for it
  READY // written; the proposal now holds it, and Approve applies it
}

// One Redraft of an AI proposal, numbered from 1 (the proposal as first drafted, kept
// when the first Request changes is made). The proposal itself always holds its latest
// READY Redraft, so Approve applies only that one. `content` is the Redraft as the
// proposal held it (`RedraftContent` in @vorasaan/shared); `feedback` and `pointer` are
// what caused it, kept for eval cases. Exactly one of the four proposal ids is set, and
// matches `proposalKind` and `proposalId`.
model Redraft {
  id                  String             @id @default(uuid())
  proposalKind        ProposalKind
  proposalId          String
  number              Int
  status              RedraftStatus      @default(READY)
  content             Json? // null while WRITING
  // What the person asked to change (null for Redraft 1), and the part they pointed at:
  // { kind: "CHOICE", label } or { kind: "LINES", from, to } or { kind: "SECTION", heading }.
  feedback            String?
  pointer             Json?
  requestedById       String?
  // What the AI says it changed, and the preferences it found in the feedback.
  summary             String?
  preferences         String[]
  // The model that wrote it (ticket 0054), as it was then (see SpecProposal).
  approvedModelId     String?
  modelDisplayName    String?
  modelName           String?
  createdAt           DateTime           @default(now())
  readyAt             DateTime?
  requestId           String?
  specProposalId      String?
  briefProposalId     String?
  featureSuggestionId String?
  promptVersionId     String?
  requestedBy         User?              @relation("RedraftRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  request             DecisionRequest?   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  specProposal        SpecProposal?      @relation(fields: [specProposalId], references: [id], onDelete: Cascade)
  briefProposal       BriefProposal?     @relation(fields: [briefProposalId], references: [id], onDelete: Cascade)
  featureSuggestion   FeatureSuggestion? @relation(fields: [featureSuggestionId], references: [id], onDelete: Cascade)
  promptVersion       PromptVersion?     @relation(fields: [promptVersionId], references: [id], onDelete: Cascade)

  @@unique([proposalKind, proposalId, number])
  @@index([requestId])
  @@index([specProposalId])
  @@index([briefProposalId])
  @@index([featureSuggestionId])
  @@index([promptVersionId])
  @@index([requestedById])
}

// ─── Receipts (ADR 0015, ticket 0070) ───────────────────────────────────────

// What an AI call produced, referenced by id (never copied).
enum ReceiptOutputKind {
  CHOICES // a Decision Request's Choices (the request's id)
  SPEC_PROPOSAL
  BRIEF_PROPOSAL
  FEATURE_SUGGESTION_BATCH // the Feature Suggestions generated together (their batchId)
  REDRAFT // a Redraft of a proposal (the Redraft's id)
  CONVERSATION_MESSAGE // a reply in a Conversation
  CONVERSATION // a Conversation Summary (the Conversation's id)
  ATTACHMENT // an Attachment's summary
  GRILLING_ROUND // a Grilling round's questions
  GRILLING_QUESTION // a follow-up on a Grilling question
  PROMPT_ANALYSIS // the patterns the AI found in a prompt's feedback (ticket 0072)
  PROMPT_VERSION // a Prompt Version the AI proposed
}

enum ReceiptOutcomeKind {
  APPROVE
  DECLINE // with its reason, when one was given
  REQUEST_CHANGES // with its feedback (ADR 0013)
  MANUAL_EDIT // edited by hand: the Choices before sending, or the next Spec or Brief Version
}

// The record of one AI call (a Receipt). Never the prompt or the reply: the task, the prompt
// and its Prompt Version, the model, tokens, cache use, latency and a reference to what it
// produced. Kept for the Organization's retention (receiptRetentionDays), then deleted with
// its outcomes.
model Receipt {
  id               String             @id @default(uuid())
  task             String // the AI task, e.g. generateChoices
  taskKind         String // its Settings task (AiTaskKind), e.g. CHOICES
  promptName       String // the prompt it rendered (a packages/skills name)
  promptVersion    String // "default@<hash>" for the built-in default
  modelSource      String? // APPROVED_MODEL or ENV
  approvedModelId  String? // a plain id, so the Receipt outlives the model
  modelName        String? // the provider's model id, or the env "provider/model"
  providerKind     String? // ANTHROPIC, OPENAI, OPENROUTER...
  language         String? // the Reply Language asked for
  inputTokens      Int?
  outputTokens     Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  latencyMs        Int
  success          Boolean
  error            String? // a short, redacted message when it failed
  outputKind       ReceiptOutputKind?
  outputId         String?
  // The proposal it drafted or redrafted, and which Redraft (1 for the first draft).
  proposalKind     ProposalKind?
  proposalId       String?
  redraft          Int?
  requestedById    String?
  // The eval run (ticket 0071) the call was made for; null for the product's own calls.
  // A replay never picks these.
  evalRunId        String?
  // The Project the call worked for (ticket 0075), a plain id so the Receipt outlives it;
  // null for Organization-wide work (Prompt proposals, Eval Runs).
  projectId        String?
  createdAt        DateTime           @default(now())
  requestedBy      User?              @relation("ReceiptRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  outcomes         ReceiptOutcome[]   @relation("ReceiptOutcomes")
  redraftOutcomes  ReceiptOutcome[]   @relation("ReceiptRedraftOutcomes")

  @@index([createdAt])
  @@index([proposalKind, proposalId, redraft])
  @@index([outputKind, outputId])
  @@index([requestedById])
  @@index([evalRunId])
}

// What people did with a proposal, linked to the Receipt that drafted it (`receiptId`)
// and, for a Redraft after the first, to the Receipt that wrote it (`redraftReceiptId`).
model ReceiptOutcome {
  id                     String             @id @default(uuid())
  receiptId              String
  redraftReceiptId       String?
  kind                   ReceiptOutcomeKind
  proposalKind           ProposalKind
  proposalId             String
  redraft                Int // the Redraft it was given on
  reason                 String? // DECLINE: the reason; REQUEST_CHANGES: the feedback
  redraftsBeforeApproval Int? // APPROVE: how many Redrafts were written before it
  choiceLabel            String? // APPROVE of Choices: the Choice decided
  editSize               Int? // MANUAL_EDIT: lines added plus lines removed
  actorId                String?
  createdAt              DateTime           @default(now())
  receipt                Receipt            @relation("ReceiptOutcomes", fields: [receiptId], references: [id], onDelete: Cascade)
  redraftReceipt         Receipt?           @relation("ReceiptRedraftOutcomes", fields: [redraftReceiptId], references: [id], onDelete: SetNull)
  actor                  User?              @relation("ReceiptOutcomeBy", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([redraftReceiptId])
  @@index([proposalKind, proposalId])
  @@index([createdAt])
  @@index([actorId])
}

// ─── Prompt Versions and evals (ADR 0015, ticket 0071) ──────────────────────

enum PromptVersionStatus {
  PROPOSED // written by an Admin or proposed by the AI, waiting for an Admin's approval
  APPROVED // may be active; the active one is the latest PromptActivation of its prompt
  DECLINED
}

// An Organization's own version of one of the built-in prompts (a packages/skills name),
// on top of the default. Numbered per prompt when written, and immutable once decided: only
// its status moves, PROPOSED to APPROVED or DECLINED. One the AI proposed (ticket 0072) holds
// its latest Redraft while PROPOSED, like every AI proposal (ADR 0013).
model PromptVersion {
  id             String              @id @default(uuid())
  organizationId String
  promptName     String // a packages/skills name, e.g. generate-choices
  number         Int // 1, 2, ... per prompt; the built-in default is 0
  template       String // the prompt's Markdown, placeholders and partials as written
  note           String? // what it changes and why
  status         PromptVersionStatus @default(PROPOSED)
  proposedById   String?
  approvedById   String?
  approvedAt     DateTime?
  declinedById   String?
  declinedAt     DateTime?
  declineReason  String?
  // Proposed by the AI (ticket 0072): the analysis it came from, and why it changes what it does.
  analysisId     String?             @unique
  rationale      String?
  // The evals run on it automatically, and on the version active then, for its current Redraft.
  evalRunId      String?
  baselineRunId  String?
  createdAt      DateTime            @default(now())
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposedBy     User?               @relation("PromptVersionProposedBy", fields: [proposedById], references: [id], onDelete: SetNull)
  approvedBy     User?               @relation("PromptVersionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  declinedBy     User?               @relation("PromptVersionDeclinedBy", fields: [declinedById], references: [id], onDelete: SetNull)
  activations    PromptActivation[]
  evalRuns       PromptEvalRun[]
  analysis       PromptAnalysis?     @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  evalRun        PromptEvalRun?      @relation("PromptVersionEvalRun", fields: [evalRunId], references: [id], onDelete: SetNull)
  baselineRun    PromptEvalRun?      @relation("PromptVersionBaselineRun", fields: [baselineRunId], references: [id], onDelete: SetNull)
  redrafts       Redraft[]

  @@unique([organizationId, promptName, number])
  @@index([proposedById])
  @@index([approvedById])
  @@index([declinedById])
  @@index([evalRunId])
  @@index([baselineRunId])
}

enum PromptActivationKind {
  APPROVE // a Prompt Version approved, and so made active
  ROLLBACK // an earlier Prompt Version, or the default, made active again
}

// Which version of a prompt is active, as a log: the latest row of a prompt wins, and no
// row means the built-in default. Rollbacks are rows too, so the history keeps them.
model PromptActivation {
  id             String               @id @default(uuid())
  seq            Int                  @default(autoincrement()) // the order they happened in
  organizationId String
  promptName     String
  versionId      String? // null: the built-in default
  kind           PromptActivationKind
  actorId        String?
  createdAt      DateTime             @default(now())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version        PromptVersion?       @relation(fields: [versionId], references: [id], onDelete: Cascade)
  actor          User?                @relation("PromptActivationBy", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, promptName, seq])
  @@index([versionId])
  @@index([actorId])
}

enum PromptEvalRunStatus {
  RUNNING
  DONE
  FAILED
}

// One eval run of a prompt's version (the default or a Prompt Version) on an Approved
// Model: the checked-in eval cases and/or a replay of approved Receipts, run in the
// background. Its calls leave Receipts marked with its id; their tokens are summed here
// when it ends.
model PromptEvalRun {
  id               String              @id @default(uuid())
  organizationId   String
  promptName       String
  versionId        String? // null: the built-in default
  promptVersion    String // as Receipts name it: default@<hash> or v<n>@<hash>
  approvedModelId  String? // a plain id, so the run outlives the model
  modelDisplayName String
  modelName        String
  sources          String[] // CHECKED_IN, REPLAY
  status           PromptEvalRunStatus @default(RUNNING)
  total            Int                 @default(0)
  done             Int                 @default(0)
  score            Float? // the mean of its cases' scores, once done
  error            String?
  inputTokens      Int?
  outputTokens     Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  startedById      String?
  createdAt        DateTime            @default(now())
  finishedAt       DateTime?
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version          PromptVersion?      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  startedBy        User?               @relation("PromptEvalRunStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  cases            PromptEvalCase[]
  proposalsAfter   PromptVersion[]     @relation("PromptVersionEvalRun")
  proposalsBefore  PromptVersion[]     @relation("PromptVersionBaselineRun")

  @@index([organizationId, promptName, createdAt])
  @@index([versionId])
  @@index([startedById])
}

// One case of an eval run: its score (0 to 1, the share of its checks passed), each
// check, and the output as a sample. A replay case names the Receipt it replayed.
model PromptEvalCase {
  id        String        @id @default(uuid())
  runId     String
  position  Int
  set       String // the eval set (choices, grilling...) or "replay"
  caseKey   String // stable across runs, so two runs compare case by case
  name      String
  score     Float
  checks    Json // [{ name, passed, detail }]
  output    Json? // the output as a sample; null when the call failed
  error     String?
  receiptId String? // replay: the approved Receipt replayed (a plain id)
  latencyMs Int
  createdAt DateTime      @default(now())
  run       PromptEvalRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, caseKey])
}

// ─── The AI proposes Prompt Versions (ADR 0015, ticket 0072) ────────────────

enum PromptAnalysisStatus {
  RUNNING
  DONE // patterns named, and a Prompt Version proposed when any were found
  FAILED
}

enum PromptAnalysisTrigger {
  MANUAL // an Admin asked, from Settings
  FEEDBACK // enough new outcomes were linked to the prompt's Receipts
}

// One reading of a prompt's feedback by the AI: the outcomes linked to its Receipts, and the
// patterns it named in them, each with the cases it cites ([{ title, description, count,
// cases: [{ outcomeId, receiptId, kind, proposalKind, proposalId, redraft, text }] }]).
// When it found any, the AI proposed a Prompt Version from them (PromptVersion.analysisId).
model PromptAnalysis {
  id             String                @id @default(uuid())
  organizationId String
  promptName     String
  trigger        PromptAnalysisTrigger
  status         PromptAnalysisStatus  @default(RUNNING)
  outcomes       Int                   @default(0) // how many outcomes it read
  patterns       Json? // null until done
  error          String?
  requestedById  String?
  createdAt      DateTime              @default(now())
  finishedAt     DateTime?
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy    User?                 @relation("PromptAnalysisRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  version        PromptVersion?

  @@index([organizationId, promptName, createdAt])
  @@index([requestedById])
}
