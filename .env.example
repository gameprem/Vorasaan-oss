# Docker install: only VORASAAN_SECRET_KEY is required.
# Development: copy to .env; Prisma commands read DATABASE_URL from the environment.

DATABASE_URL=postgresql://vorasaan:vorasaan@localhost:5432/vorasaan
# Server tests create and migrate this database automatically; its name must end in _test.
TEST_DATABASE_URL=postgresql://vorasaan:vorasaan@localhost:5432/vorasaan_test

# DEV ONLY: accept the x-vorasaan-user header and show the web user switcher.
# Seeded users can also sign in with password "vorasaan-demo".
# VORASAAN_DEV_AUTH=true

# Encrypts OrgIntegration secrets at rest. Generate with: openssl rand -base64 32
VORASAAN_SECRET_KEY=

# Optional. First-run setup needs a Setup Token. Unset, the server prints a new one to its log
# at each start until setup is done (docker compose logs server | grep -i setup). Set your own
# (at least 20 characters, e.g. openssl rand -base64 24) to skip reading the log, or when
# running several server instances. Never printed. Spent once setup is done.
# VORASAAN_SETUP_TOKEN=

# Dev/seed only. In a real install the Admin enters the LLM key in /setup.
ANTHROPIC_API_KEY=

# Set to "fake" to run without an LLM key (canned Choices and Spec Proposals, fake embeddings).
# VORASAAN_AI=fake

# Models normally come from Settings → AI models (Approved Models, with a model per task).
# These env vars use Mastra's "provider/model" form:
# - VORASAAN_MODEL_<TASK>, when set, wins over Settings for that task. An "anthropic/…",
#   "openai/…" or "openrouter/…" model uses the key of a connected provider of that kind,
#   else the env key (ANTHROPIC_API_KEY, OPENAI_API_KEY, OPENROUTER_API_KEY).
# - VORASAAN_MODEL applies only while there is no Approved Model (development, before setup).
#   Defaults to anthropic/claude-opus-5-5.
# VORASAAN_MODEL=
# VORASAAN_MODEL_GENERATE_CHOICES=
# VORASAAN_MODEL_DRAFT_SPEC_PROPOSAL=
# VORASAAN_MODEL_SUMMARIZE_ATTACHMENT=
# VORASAAN_MODEL_DRAFT_SPEC_FROM_ATTACHMENTS=
# VORASAAN_MODEL_GRILLING_QUESTIONS=
# VORASAAN_MODEL_DRAFT_BRIEF_FROM_GRILLING=
# VORASAAN_MODEL_SUGGEST_FEATURES=
# VORASAAN_MODEL_DRAFT_SPEC_FROM_SUGGESTION=
# VORASAAN_MODEL_CHECK_FEATURE_FIT=
# VORASAAN_MODEL_CHAT=
# VORASAAN_MODEL_SUMMARIZE_CONVERSATION=

# The context window (tokens) of an env model, and of a new Approved Model whose model id
# isn't a known one (ticket 0060). Every AI task's budget is a share of the window.
# Defaults to 32000; an Approved Model's own window is edited in Settings → AI models.
# VORASAAN_CONTEXT_WINDOW=

# Tests only: where OpenRouter calls and its model list go instead of https://openrouter.ai/api/v1
# (ticket 0064). An Admin can never change OpenRouter's URL; leave this unset.
# OPENROUTER_BASE_URL=

# Attachment file storage: "local" (default) or "s3" (any S3-compatible: S3, MinIO, R2).
FILE_STORAGE_DRIVER=local
# Relative to the server's working directory (apps/server in development).
FILE_STORAGE_LOCAL_DIR=./data/files
# With FILE_STORAGE_DRIVER=s3. S3_BUCKET is required; leave S3_ENDPOINT empty for AWS.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Attachment limits. Largest upload or fetched page (bytes, default 20 MiB),
# and longest Snapshot (characters; longer text is truncated).
# ATTACHMENT_MAX_BYTES=20971520
# ATTACHMENT_SNAPSHOT_MAX_CHARS=200000
# URL Attachments refuse private, loopback and link-local addresses (SSRF guard).
# Set true to allow them, e.g. to attach pages from an intranet wiki.
# ATTACHMENT_ALLOW_PRIVATE_URLS=false

# The Atlassian site (Settings → Atlassian) must use https. Local development
# against a fake http server only: set true to allow http.
# ATLASSIAN_ALLOW_HTTP=false

# Chat apps (Settings → Chat apps) call the real LINE, Slack and Bot Framework APIs.
# Tests and local development against fake servers only: point them elsewhere.
# VORASAAN_LINE_API_URL=https://api.line.me
# VORASAAN_SLACK_API_URL=https://slack.com/api
# VORASAAN_TEAMS_TOKEN_URL=https://login.microsoftonline.com/botframework.com/oauth2/v2.0/token
# VORASAAN_TEAMS_OPENID_URL=https://login.botframework.com/v1/.well-known/openidconfiguration
# Where people open the web app: the "Open in Vorasaan" links on LINE, Slack and Teams cards,
# and the setup link the server prints.
# VORASAAN_WEB_URL=http://localhost:3000

# Docker host ports (docker compose)
# VORASAAN_WEB_PORT=3000
# VORASAAN_API_PORT=4000
# VORASAAN_DB_PORT=5432
# Set true only when serving the web app over plain HTTP on a non-localhost address.
# VORASAAN_INSECURE_COOKIES=false
