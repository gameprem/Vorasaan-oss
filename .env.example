# Docker install: only VORASAAN_SECRET_KEY is required.
# Development: copy to .env; Prisma commands read DATABASE_URL from the environment.

DATABASE_URL=postgresql://vorasaan:vorasaan@localhost:5432/vorasaan
# Server tests create and migrate this database automatically; its name must end in _test.
TEST_DATABASE_URL=postgresql://vorasaan:vorasaan@localhost:5432/vorasaan_test

# DEV ONLY: accept the x-vorasaan-user header and show the web user switcher.
# Seeded users can also sign in with password "vorasaan-demo".
# VORASAAN_DEV_AUTH=true

# Encrypts OrgIntegration secrets at rest. Generate with: openssl rand -base64 32
VORASAAN_SECRET_KEY=

# Dev/seed only. In a real install the Admin enters the LLM key in /setup.
ANTHROPIC_API_KEY=

# Set to "fake" to run without an LLM key (canned Choices and Spec Proposals).
# VORASAAN_AI=fake

# Model per AI task (Mastra "provider/model"). Defaults to anthropic/claude-opus-5-5.
# VORASAAN_MODEL=
# VORASAAN_MODEL_GENERATE_CHOICES=
# VORASAAN_MODEL_DRAFT_SPEC_PROPOSAL=
# VORASAAN_MODEL_SUMMARIZE_ATTACHMENT=
# VORASAAN_MODEL_DRAFT_SPEC_FROM_ATTACHMENTS=

# Attachment file storage: "local" (default) or "s3" (any S3-compatible: S3, MinIO, R2).
FILE_STORAGE_DRIVER=local
# Relative to the server's working directory (apps/server in development).
FILE_STORAGE_LOCAL_DIR=./data/files
# With FILE_STORAGE_DRIVER=s3. S3_BUCKET is required; leave S3_ENDPOINT empty for AWS.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Attachment limits. Largest upload or fetched page (bytes, default 20 MiB),
# and longest Snapshot (characters; longer text is truncated).
# ATTACHMENT_MAX_BYTES=20971520
# ATTACHMENT_SNAPSHOT_MAX_CHARS=200000
# URL Attachments refuse private, loopback and link-local addresses (SSRF guard).
# Set true to allow them, e.g. to attach pages from an intranet wiki.
# ATTACHMENT_ALLOW_PRIVATE_URLS=false

# The Atlassian site (Settings → Atlassian) must use https. Local development
# against a fake http server only: set true to allow http.
# ATLASSIAN_ALLOW_HTTP=false

# Docker host ports (docker compose)
# VORASAAN_WEB_PORT=3000
# VORASAAN_API_PORT=4000
# VORASAAN_DB_PORT=5432
# Set true only when serving the web app over plain HTTP on a non-localhost address.
# VORASAAN_INSECURE_COOKIES=false
